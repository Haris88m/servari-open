{
  "name": "servari-shell",
  "version": "2.0.1",
  "private": true,
  "description": "SERVARI — the operating-system shell. Electron window over the SERVARI server (127.0.0.1:8911).",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --config.compression=store",
    "test": "playwright test tests/servari-qa.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "io.servari.app",
    "productName": "SERVARI",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "electron/main.cjs",
      "electron/servari.ico",
      "electron/servari-256.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/servari.ico"
    },
    "portable": {
      "artifactName": "SERVARI-${arch}.exe"
    }
  }
}
