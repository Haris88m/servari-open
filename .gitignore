# --- dependencies ---
node_modules/
ui/node_modules/

# --- build output ---
dist/
ui/dist/
dist-exe/
*.tsbuildinfo

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- BYOM secret config (NEVER commit a key) ---
config.json
.env
.env.*
*.env

# --- voice models + synthesized audio (downloaded / generated on first run) ---
_tts_models/
_tts_cache/
*.wav

# --- verification artifacts written by scripts/verify_all.py ---
verification/

# --- runtime demo state written by the running shell ---
demo-data/context/audit.jsonl
demo-data/_voice_debug.jsonl
demo-data/engine-executed.jsonl
demo-data/retention/runs/run_*/
demo-data/reports/*_session_*.md
demo-data/reports/*_today.md
# dated all-time reports are per-run artifacts; keep only the one curated demo report
demo-data/reports/*_all_time.md
!demo-data/reports/2026-06-01_0900_all_time.md

# --- logs ---
*.log
*.err
_smoke_server.log
live-server.log

# --- stray test/runtime artifacts ---
test-results/
openclaw-workspace/
verification/_verify_home/

# --- local browser verification artifacts ---
.playwright-cli/
output/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
